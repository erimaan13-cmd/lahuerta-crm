  MS --> MA["Muestra aprobada"] --> COT
  COT --> NEG["Negociacion"] --> G{"Decision"}
  COT --> G
  G -- "perdida + motivo" --> LO["Perdida"]
  G -- ganada --> W["Ganada<br/>tarea para Administracion"]
  W --> PED["Pedido en el sistema<br/>folio PED · descuenta inventario al ENTREGAR"]
  PED --> ENT["Entrega<br/>salida por caducidad mas proxima<br/>la factura la emite CONTPAQi: aqui solo el folio"]
  ENT --> SEG["Seguimiento"]
  SEG --> INC{"Hay una incidencia"}
  INC -- si --> CASE["Caso / reclamacion<br/>el lote es obligatorio"]
  INC -- no --> RC["Recompra<br/>nueva oportunidad tipo recompra"]
  CASE --> RC

  NOTA["OJO: las etapas dependen del TIPO de oportunidad.<br/>Una estandar o de recompra NO pasa por formula ni muestra,<br/>y una de formula personalizada sigue el orden estricto"]

