flowchart TB
  USERS[Usuarios internos<br/>10 roles]

  subgraph RUTAS["1 · RUTAS · validan permiso y forma, NO deciden reglas"]
    R1["main.py<br/>CRM comercial + historial + usuarios"]
    R2["routers/sales.py · inventory.py · procurement.py"]
    R3["routers/rrhh.py · pettycash.py · maintenance.py"]
    R4["routers/notifications.py · files.py"]
  end

  subgraph SVC["2 · SERVICIOS · aplican las reglas y registran en la bitácora"]
    C1["crm.py · pipeline.py<br/>prospectos · cuentas · oportunidades · cotizaciones · casos"]
    C2["email_pipeline.py<br/>clasifica y sugiere"]
    C3["dashboard.py · automations.py · users.py"]
    O1["sales.py<br/>pedidos"]
    O2["inventory.py<br/>UNICO dueño de existencias"]
    O3["procurement.py<br/>compras"]
    O4["hr.py · pettycash.py · maintenance.py"]
    O5["notifications.py · files.py"]
  end

  subgraph DOM["3 · MODELOS · app/models.py"]
    M["Entidades y restricciones"]
    SM[("stock_movements<br/>entradas y salidas, nunca un saldo")]
    AE[("audit_events<br/>solo se agrega, cadena SHA-256")]
  end

  DB[("SQLite hoy · PostgreSQL P1")]

  subgraph TRANS["Transversal · lo usan todas las capas"]
    W["web.py<br/>plantillas · sesión · CSRF"]
    P["permissions.py<br/>rol→permisos"]
    A["audit.py<br/>record y verify_chain"]
    B["business_time.py · common.py · config.py"]
  end

  subgraph CLS["Clasificador · app/classifier · NO toca la base de datos"]
    N[normalize] --> RL[rules] --> EN[engine]
    EX[extract] --> EN
    LL["llm.py · puerto apagado"]
  end

  subgraph INT["Integraciones · app/integrations"]
    EP["email_providers.py<br/>SOLO LECTURA"]
    ER["erp.py<br/>simulado"]
  end

  subgraph FUERA["Fuera del sistema · no lo hace el CRM"]
    CP["CONTPAQi<br/>emite las facturas"]
    BUZ["Buzón de correo"]
    TEL["Teléfono · WhatsApp · papel"]
  end

